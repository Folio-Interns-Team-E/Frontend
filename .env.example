# In local development, leave this unset to use Vite's /api proxy.
# Set it to the deployed FastAPI base URL in production.
VITE_API_URL=https://api.example.com
VITE_GOOGLE_CLIENT_ID=1029292325850-0drfa3uhjbqd955gt2lq4d39rag273fc.apps.googleusercontent.com

# Optional production error monitoring. Leave the DSN empty to disable it.
VITE_SENTRY_DSN=
